# Chromium session databases, credentials, locks and disposable caches.
/imports/
/user-data/*
!/user-data/studio-settings.json
**/__pycache__/
*.py[cod]
*.log
*.tmp
*.lock
/runtime/virtual-camera/last-error.log
/assets/desktop-shortcut.original.lnk
.env
.env.*
!.env.example
Thumbs.db
desktop.ini

